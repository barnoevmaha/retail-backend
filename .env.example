DATABASE_URL=postgresql://clothes_shop:clothes_shop@localhost:5432/clothes_shop
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
UPLOAD_DIR=uploads
SMS_PROVIDER=mock
TELEGRAM_BOT_TOKEN=
COMPANY_NAME=Clothes Shop

# Super admin bootstrap (first boot only — creates the admin if none exists)
# Employees are created by the super admin from the admin panel — no other seeded credentials.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Email delivery: "mock" (prints codes to logs, sends nothing) or "resend"
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=noreply@YOURDOMAIN.com

# Translation (auto-translate UI strings EN -> RU/UZ; provider auto-detected by key)
# TRANSLATION_PROVIDER=gemini   # gemini | openai | deepl | google ("" = auto-detect)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Eskiz SMS
SMS_PROVIDER=mock
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
